{{ 'header-main.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-main.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #shopify-section-{{ section.id }} {
    --hdr-bg-color: {{ section.settings.hdr_bg_color }};
    --hdr-text-color: {{ section.settings.hdr_text_color }};
    --hdr-hover-color: {{ section.settings.hdr_hover_color }};
    --hdr-border-color: {{ section.settings.hdr_border_color }};
    --hdr-padding-top: {{ section.settings.hdr_padding_top }}px;
    --hdr-padding-bottom: {{ section.settings.hdr_padding_bottom }}px;
    --hdr-height-desktop: {{ section.settings.hdr_height_desktop }}px;
    --hdr-height-mobile: {{ section.settings.hdr_height_mobile }}px;
    --hdr-logo-width-desktop: {{ section.settings.hdr_logo_width_desktop }}px;
    --hdr-logo-width-mobile: {{ section.settings.hdr_logo_width_mobile }}px;
    --hdr-icon-size: {{ section.settings.hdr_icon_size }}px;
    --hdr-border-width: {{ section.settings.hdr_border_width }}px;
    --hdr-nav-font-size: {{ section.settings.hdr_nav_font_size }}px;
    --hdr-nav-font-weight: {{ section.settings.hdr_nav_font_weight }};
    --hdr-nav-text-transform: {{ section.settings.hdr_nav_text_transform }};
    --hdr-nav-letter-spacing: {{ section.settings.hdr_nav_letter_spacing | times: 0.01 }}em;
    --hdr-nav-item-spacing: {{ section.settings.hdr_nav_item_spacing }}px;
    --hdr-hover-transition: {{ section.settings.hdr_hover_transition | times: 0.1 }}s;
    --hdr-shadow-intensity: {{ section.settings.hdr_shadow_intensity }};
    --hdr-dropdown-bg: {{ section.settings.hdr_dropdown_bg }};
    --hdr-dropdown-text: {{ section.settings.hdr_dropdown_text_color }};
    --hdr-dropdown-hover: {{ section.settings.hdr_dropdown_hover_color }};
    --hdr-dropdown-hover-bg: {{ section.settings.hdr_dropdown_hover_bg }};
    --hdr-dropdown-border: {{ section.settings.hdr_dropdown_border_color }};
    --hdr-dropdown-radius: {{ section.settings.hdr_dropdown_border_radius }}px;
    --hdr-dropdown-padding: {{ section.settings.hdr_dropdown_padding }}px;
    --hdr-dropdown-item-spacing: {{ section.settings.hdr_dropdown_item_spacing }}px;
    --hdr-dropdown-font-size: {{ section.settings.hdr_dropdown_font_size }}px;
    --hdr-dropdown-font-weight: {{ section.settings.hdr_dropdown_font_weight }};
    --hdr-dropdown-width: {{ section.settings.hdr_dropdown_width }}px;
    --hdr-mega-bg: {{ section.settings.hdr_mega_bg }};

    --hdr-mega-text: {{ section.settings.hdr_mega_text_color }};
    --hdr-mega-heading-size: {{ section.settings.hdr_mega_heading_size }}px;
    --hdr-mega-heading-weight: {{ section.settings.hdr_mega_heading_weight }};
    --hdr-mega-link-size: {{ section.settings.hdr_mega_link_size }}px;
    --hdr-mega-column-spacing: {{ section.settings.hdr_mega_column_spacing }}px;
    --hdr-mega-padding: {{ section.settings.hdr_mega_padding }}px;
    --hdr-drawer-bg: {{ section.settings.hdr_drawer_bg_color }};
    --hdr-drawer-text: {{ section.settings.hdr_drawer_text_color }};
    --hdr-drawer-link: {{ section.settings.hdr_drawer_link_color }};
    --hdr-drawer-link-hover: {{ section.settings.hdr_drawer_link_hover }};
    --hdr-drawer-border: {{ section.settings.hdr_drawer_border_color }};
    --hdr-drawer-overlay: {{ section.settings.hdr_drawer_overlay_color }};
    --hdr-drawer-overlay-opacity: {{ section.settings.hdr_drawer_overlay_opacity | times: 0.01 }};
    --hdr-drawer-width: {{ section.settings.hdr_drawer_width }}%;
    --hdr-drawer-speed: {{ section.settings.hdr_drawer_animation_speed | times: 0.1 }}s;
    --hdr-drawer-font-size: {{ section.settings.hdr_drawer_font_size }}px;
    --hdr-drawer-font-weight: {{ section.settings.hdr_drawer_font_weight }};
    --hdr-drawer-text-transform: {{ section.settings.hdr_drawer_text_transform }};
    --hdr-drawer-item-spacing: {{ section.settings.hdr_drawer_item_spacing }}px;
    --hdr-drawer-padding: {{ section.settings.hdr_drawer_padding }}px;
    --hdr-drawer-nested-indent: {{ section.settings.hdr_drawer_nested_indent }}px;
    --hdr-drawer-close-size: {{ section.settings.hdr_drawer_close_size }}px;
  }

  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      --hdr-height-desktop: {{ section.settings.hdr_height_mobile }}px;
      --hdr-logo-width-desktop: {{ section.settings.hdr_logo_width_mobile }}px;
      --hdr-padding-top: {{ section.settings.hdr_padding_top_mobile }}px;
      --hdr-padding-bottom: {{ section.settings.hdr_padding_bottom_mobile }}px;
    }
  }

  #shopify-section-{{ section.id }} .header-wrapper {
    background-color: var(--hdr-bg-color);
    color: var(--hdr-text-color);
    min-height: var(--hdr-height-desktop);
    padding-top: var(--hdr-padding-top);
    padding-bottom: var(--hdr-padding-bottom);
    border-bottom: var(--hdr-border-width) solid var(--hdr-border-color);
  }

  {%- unless section.settings.hdr_show_border -%}
    #shopify-section-{{ section.id }} .header-wrapper {
      border-bottom: none;
    }
  {%- endunless -%}

  {%- if section.settings.hdr_enable_shadow -%}
    #shopify-section-{{ section.id }} .header-wrapper {
      box-shadow: 0 2px 4px rgba(0, 0, 0, calc(var(--hdr-shadow-intensity) * 0.01));
    }
  {%- endif -%}

  {%- if section.settings.hdr_sticky_shadow -%}
    #shopify-section-{{ section.id }} .header-section.is-sticky .header-wrapper {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
  {%- endif -%}

  {%- if section.settings.hdr_enable_transparent -%}
    #shopify-section-{{ section.id }} .header-wrapper--transparent {
      background-color: transparent;
      color: {{ section.settings.hdr_transparent_text }};
      border-bottom-color: transparent;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .header__logo-wrapper {
    max-width: var(--hdr-logo-width-desktop);
  }

  #shopify-section-{{ section.id }} .header__nav-link {
    color: var(--hdr-text-color);
    font-size: var(--hdr-nav-font-size);
    font-weight: var(--hdr-nav-font-weight);
    text-transform: var(--hdr-nav-text-transform);
    letter-spacing: var(--hdr-nav-letter-spacing);
    transition: color var(--hdr-hover-transition) ease, opacity var(--hdr-hover-transition) ease;
  }

  #shopify-section-{{ section.id }} .header__nav-list .header__nav-item {
    margin-right: var(--hdr-nav-item-spacing);
  }

  #shopify-section-{{ section.id }} .header__nav-link:hover {
    color: var(--hdr-hover-color);
  }

  {% if section.settings.hdr_nav_hover_style == 'underline' %}
    #shopify-section-{{ section.id }} .header__nav-link:hover {
      text-decoration: underline;
      text-underline-offset: 0.4em;
    }
  {% elsif section.settings.hdr_nav_hover_style == 'overline' %}
    #shopify-section-{{ section.id }} .header__nav-link:hover {
      text-decoration: overline;
    }
  {% elsif section.settings.hdr_nav_hover_style == 'fade' %}
    #shopify-section-{{ section.id }} .header__nav-link:hover {
      opacity: 0.7;
    }
  {% elsif section.settings.hdr_nav_hover_style == 'background' %}
    #shopify-section-{{ section.id }} .header__nav-link:hover {
      background-color: rgba(0, 0, 0, 0.05);
      border-radius: 4px;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .header__icon-button svg {
    color: var(--hdr-text-color);
    width: var(--hdr-icon-size);
    height: var(--hdr-icon-size);
  }

  /* Dropdown */
  #shopify-section-{{ section.id }} .mega-menu {
    background-color: var(--hdr-mega-bg);
    color: var(--hdr-mega-text);
    padding: var(--hdr-mega-padding);
  }

  #shopify-section-{{ section.id }} .mega-menu__column {
    padding-right: var(--hdr-mega-column-spacing);
  }

  #shopify-section-{{ section.id }} .mega-menu__link {
    font-size: var(--hdr-mega-link-size);
    color: var(--hdr-mega-text);
  }

  #shopify-section-{{ section.id }} .mega-menu__column-heading {
    font-size: var(--hdr-mega-heading-size);
    font-weight: var(--hdr-mega-heading-weight);
  }

  /* Dropdown shadow */
  {% if section.settings.hdr_dropdown_shadow == 'small' %}
    #shopify-section-{{ section.id }} .mega-menu { box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
  {% elsif section.settings.hdr_dropdown_shadow == 'medium' %}
    #shopify-section-{{ section.id }} .mega-menu { box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
  {% elsif section.settings.hdr_dropdown_shadow == 'large' %}
    #shopify-section-{{ section.id }} .mega-menu { box-shadow: 0 8px 32px rgba(0,0,0,0.16); }
  {% endif %}

  /* Dropdown animation */
  {% if section.settings.hdr_dropdown_animation == 'fade' %}
    #shopify-section-{{ section.id }} .mega-menu { animation: hdrFadeIn 0.2s ease; }
  {% elsif section.settings.hdr_dropdown_animation == 'slide-down' %}
    #shopify-section-{{ section.id }} .mega-menu { animation: hdrSlideDown 0.2s ease; }
  {% elsif section.settings.hdr_dropdown_animation == 'scale' %}
    #shopify-section-{{ section.id }} .mega-menu { animation: hdrScaleIn 0.2s ease; }
  {% endif %}

  @keyframes hdrFadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes hdrSlideDown { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes hdrScaleIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }

  /* Mobile Drawer */
  #shopify-section-{{ section.id }} .mobile-drawer__panel {
    width: var(--hdr-drawer-width);
    max-width: 400px;
    background-color: var(--hdr-drawer-bg);
    color: var(--hdr-drawer-text);
    padding: var(--hdr-drawer-padding);
    transition: transform var(--hdr-drawer-speed) cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  {% if section.settings.hdr_drawer_direction == 'right' %}
    #shopify-section-{{ section.id }} .mobile-drawer__panel {
      right: 0; left: auto; transform: translateX(100%);
    }
  {% else %}
    #shopify-section-{{ section.id }} .mobile-drawer__panel {
      left: 0; right: auto;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .mobile-accordion__trigger,
  #shopify-section-{{ section.id }} .mobile-accordion__link {
    color: var(--hdr-drawer-link);
    font-size: var(--hdr-drawer-font-size);
    font-weight: var(--hdr-drawer-font-weight);
    text-transform: var(--hdr-drawer-text-transform);
    padding-top: var(--hdr-drawer-item-spacing);
    padding-bottom: var(--hdr-drawer-item-spacing);
    transition: color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .mobile-accordion__trigger:hover,
  #shopify-section-{{ section.id }} .mobile-accordion__link:hover {
    color: var(--hdr-drawer-link-hover);
  }

  {% if section.settings.hdr_drawer_separator_style != 'none' %}
    #shopify-section-{{ section.id }} .mobile-accordion__trigger,
    #shopify-section-{{ section.id }} .mobile-accordion__link {
      border-bottom: 1px {{ section.settings.hdr_drawer_separator_style }} var(--hdr-drawer-border);
    }
  {% endif %}

  #shopify-section-{{ section.id }} .mobile-accordion__sublist .mobile-accordion__trigger,
  #shopify-section-{{ section.id }} .mobile-accordion__sublist .mobile-accordion__link {
    padding-left: var(--hdr-drawer-nested-indent);
  }

  #shopify-section-{{ section.id }} .mobile-drawer__close svg {
    width: var(--hdr-drawer-close-size);
    height: var(--hdr-drawer-close-size);
  }

  #shopify-section-{{ section.id }} .mobile-drawer__backdrop {
    background-color: var(--hdr-drawer-overlay);
    opacity: var(--hdr-drawer-overlay-opacity);
  }

  {% unless section.settings.hdr_drawer_show_social %}
    #shopify-section-{{ section.id }} .mobile-drawer__social { display: none; }
  {% endunless %}
{%- endstyle -%}


<sticky-header
  class="header-section"
  data-sticky-type="{{ section.settings.hdr_sticky_type }}"
>
  <div class="header-wrapper{% if section.settings.hdr_enable_transparent %} header-wrapper--transparent{% endif %}">
    <div class="header__container{% if section.settings.hdr_full_width %} header__container--full-width{% endif %}">
      <div class="header__split-nav">

        {%- assign main_menu = section.settings.hdr_main_menu -%}

        {%- comment -%} LEFT NAV {%- endcomment -%}
        <nav class="header__nav-left" aria-label="Main navigation left">
          {%- if main_menu != blank -%}
            <ul class="header__nav-list">
              {%- for link in main_menu.links -%}
                {%- if forloop.index <= section.settings.hdr_split_position -%}
                  {%- assign link_handle = link.title | handleize -%}
                  {%- assign has_mega_menu = false -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'mega_menu' and block.settings.hdr_mega_item_title != blank -%}
                      {%- assign mega_handle = block.settings.hdr_mega_item_title | handleize -%}
                      {%- if mega_handle == link_handle -%}
                        {%- assign has_mega_menu = true -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <li class="header__nav-item">
                    {%- if has_mega_menu -%}
                      <button
                        type="button"
                        class="header__nav-link"
                        data-mega-trigger="{{ link_handle }}"
                        aria-expanded="false"
                        aria-controls="mega-panel-{{ link_handle }}"
                      >
                        {{ link.title }}
                      </button>
                    {%- else -%}
                      <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </nav>

        {%- comment -%} CENTER LOGO {%- endcomment -%}
        <div class="header__logo-center">
          <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name | escape }}">
            {%- if section.settings.hdr_logo != blank -%}
              <div class="header__logo-wrapper">
                {%- assign logo_alt = section.settings.hdr_logo.alt | default: shop.name | escape -%}
                {%- assign logo_height = section.settings.hdr_logo_width_desktop | divided_by: section.settings.hdr_logo.aspect_ratio -%}
                {{
                  section.settings.hdr_logo
                  | image_url: width: 500
                  | image_tag:
                    class: 'header__logo-img',
                    alt: logo_alt,
                    width: section.settings.hdr_logo_width_desktop,
                    height: logo_height,
                    loading: 'eager',
                    preload: true
                }}
              </div>
            {%- else -%}
              <span class="header__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>

        {%- comment -%} RIGHT NAV + ICONS {%- endcomment -%}
        <div class="header__nav-right">
          <nav aria-label="Main navigation right">
            {%- if main_menu != blank -%}
              <ul class="header__nav-list">
                {%- for link in main_menu.links -%}
                  {%- if forloop.index > section.settings.hdr_split_position -%}
                    {%- assign link_handle = link.title | handleize -%}
                    {%- assign has_mega_menu = false -%}
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'mega_menu' and block.settings.hdr_mega_item_title != blank -%}
                        {%- assign mega_handle = block.settings.hdr_mega_item_title | handleize -%}
                        {%- if mega_handle == link_handle -%}
                          {%- assign has_mega_menu = true -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <li class="header__nav-item">
                      {%- if has_mega_menu -%}
                        <button
                          type="button"
                          class="header__nav-link"
                          data-mega-trigger="{{ link_handle }}"
                          aria-expanded="false"
                          aria-controls="mega-panel-{{ link_handle }}"
                        >
                          {{ link.title }}
                        </button>
                      {%- else -%}
                        <a href="{{ link.url }}" class="header__nav-link">{{ link.title }}</a>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </nav>

          <div class="header__icons">
            {%- if section.settings.hdr_show_search -%}
              <button
                type="button"
                class="header__icon-button"
                data-search-open
                aria-label="{{ 'general.search.search' | t }}"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                  <circle cx="11" cy="11" r="7"></circle>
                  <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
                </svg>
              </button>
            {%- endif -%}

            {%- if section.settings.hdr_show_account and shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="header__icon-button"
                aria-label="{{ 'customer.account_fallback' | t }}"
                rel="nofollow"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="8" r="4"></circle>
                  <path d="M4 20c0-4 4-7 8-7s8 3 8 7"></path>
                </svg>
              </a>
            {%- endif -%}

            <a
              href="{{ routes.cart_url }}"
              class="header__icon-button header__cart"
              aria-label="{{ 'templates.cart.cart' | t }}"
            >
              {%- if cart == empty -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                  <path d="M6 6h15l-1.5 9h-12z"></path>
                  <circle cx="9" cy="20" r="1"></circle>
                  <circle cx="18" cy="20" r="1"></circle>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                  <path d="M6 6h15l-1.5 9h-12z"></path>
                  <circle cx="9" cy="20" r="1"></circle>
                  <circle cx="18" cy="20" r="1"></circle>
                </svg>
                <span class="header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </a>

            <button
              type="button"
              class="header__icon-button header__hamburger"
              data-drawer-open
              aria-label="{{ 'sections.header.menu' | t }}"
              aria-expanded="false"
              aria-controls="mobile-drawer"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>

      </div><!-- /.header__split-nav -->

      {%- comment -%} Mega menu panels (rendered per block) {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'mega_menu' -%}
          {%- render 'header-mega-menu', block: block, section: section -%}
        {%- endif -%}
      {%- endfor -%}

    </div><!-- /.header__container -->
  </div><!-- /.header-wrapper -->
</sticky-header>

{%- render 'header-mobile-drawer', section: section -%}
{%- render 'header-search', section: section -%}


{% javascript %}
class StickyHeader extends HTMLElement {
  constructor() {
    super();
    this._scrollHandler = this._onScroll.bind(this);
    this._resizeHandler = this._onResize.bind(this);
  }

  connectedCallback() {
    this._stickyType = this.dataset.stickyType || 'none';
    this._currentScrollTop = 0;
    this._headerHeight = 0;
    this._ticking = false;

    this._measureHeight();
    window.addEventListener('resize', this._resizeHandler, { passive: true });

    if (this._stickyType === 'none') return;

    if (this._stickyType === 'always') {
      this.classList.add('is-sticky');
    }

    window.addEventListener('scroll', this._scrollHandler, { passive: true });
  }

  disconnectedCallback() {
    window.removeEventListener('scroll', this._scrollHandler);
    window.removeEventListener('resize', this._resizeHandler);
  }

  _measureHeight() {
    this._headerHeight = this.offsetHeight;
    document.documentElement.style.setProperty('--header-height', `${this._headerHeight}px`);
  }

  _onResize() {
    this._measureHeight();
  }

  _onScroll() {
    if (this._ticking) return;
    this._ticking = true;
    requestAnimationFrame(() => {
      this._handleScroll();
      this._ticking = false;
    });
  }

  _handleScroll() {
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    const pastHeader = scrollTop > this._headerHeight;

    if (this._stickyType === 'always') {
      this.classList.toggle('scrolled-past-header', pastHeader);
      this._currentScrollTop = scrollTop;
      return;
    }

    if (this._stickyType === 'on-scroll-up') {
      if (scrollTop <= this._headerHeight) {
        // Back at top — reset
        this.classList.remove('is-sticky', 'is-hidden', 'scrolled-past-header');
      } else if (scrollTop < this._currentScrollTop) {
        // Scrolling up — reveal
        this.classList.add('is-sticky', 'scrolled-past-header');
        this.classList.remove('is-hidden');
      } else if (scrollTop > this._currentScrollTop) {
        // Scrolling down — hide
        this.classList.add('is-hidden');
        this._closeMegaMenus();
      }
    }

    this._currentScrollTop = scrollTop;
  }

  _closeMegaMenus() {
    this.querySelectorAll('[data-mega-trigger]').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
    });
    this.querySelectorAll('[data-mega-panel]').forEach((panel) => {
      panel.setAttribute('aria-hidden', 'true');
    });
  }
}

if (!customElements.get('sticky-header')) {
  customElements.define('sticky-header', StickyHeader);
}

// ── Mega menu toggle ──────────────────────────────────────────────────────────
document.addEventListener('click', (e) => {
  const trigger = e.target.closest('[data-mega-trigger]');
  const header = document.querySelector('sticky-header');

  if (trigger && header) {
    const panelId = trigger.getAttribute('aria-controls');
    const panel = document.getElementById(panelId);
    const isOpen = trigger.getAttribute('aria-expanded') === 'true';

    // Close all first
    header.querySelectorAll('[data-mega-trigger]').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
    });
    header.querySelectorAll('[data-mega-panel]').forEach((p) => {
      p.setAttribute('aria-hidden', 'true');
    });

    if (!isOpen && panel) {
      trigger.setAttribute('aria-expanded', 'true');
      panel.setAttribute('aria-hidden', 'false');
    }
    return;
  }

  // Click outside — close all mega menus
  if (header && !e.target.closest('[data-mega-panel]')) {
    header.querySelectorAll('[data-mega-trigger]').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
    });
    header.querySelectorAll('[data-mega-panel]').forEach((panel) => {
      panel.setAttribute('aria-hidden', 'true');
    });
  }
});

// Close mega menu on Escape
document.addEventListener('keydown', (e) => {
  if (e.key !== 'Escape') return;
  const header = document.querySelector('sticky-header');
  if (!header) return;
  header.querySelectorAll('[data-mega-trigger]').forEach((btn) => {
    btn.setAttribute('aria-expanded', 'false');
  });
  header.querySelectorAll('[data-mega-panel]').forEach((panel) => {
    panel.setAttribute('aria-hidden', 'true');
  });
});
